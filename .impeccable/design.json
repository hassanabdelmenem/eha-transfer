  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink action bar primary; 52px, the action that finishes a screen.",
      "html": "<button class=\"ds-btn-primary\">Approve all 3</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 16px;border:0;border-radius:12px;background:var(--color-ink, #141413);color:var(--color-paper, #faf9f5);font:600 16px/1.2 ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:var(--color-slate-800, #3a392f)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-info-700, #445f7a);outline-offset:2px}"
    },
    {
      "name": "Approve Button",
      "kind": "button",
      "refersTo": "button-approve",
      "description": "Olive decision button, HoD approve only.",
      "html": "<button class=\"ds-btn-approve\">Approve</button>",
      "css": ".ds-btn-approve{min-height:48px;padding:0 12px;border:0;border-radius:10px;background:var(--color-success-700, #4c573c);color:#fff;font:600 15px/1.2 ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-approve:hover{background:var(--color-success-800, #353c2c)}.ds-btn-approve:focus-visible{outline:2px solid var(--color-info-700, #445f7a);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary card action such as Summary.",
      "html": "<button class=\"ds-btn-outline\">Summary</button>",
      "css": ".ds-btn-outline{min-height:48px;padding:0 12px;border:1px solid var(--color-slate-300, #b0aea5);border-radius:10px;background:#fff;color:var(--color-ink, #141413);font:600 15px/1.2 ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-outline:hover{background:var(--color-slate-50, #faf9f5)}.ds-btn-outline:focus-visible{outline:2px solid var(--color-info-700, #445f7a);outline-offset:2px}"
    },
    {
      "name": "Priority Chip",
      "kind": "chip",
      "refersTo": "chip-emergency",
      "description": "Text chip paired with the 6px rail; emergency, urgent, routine.",
      "html": "<span class=\"ds-chip ds-chip-em\">EMERGENCY</span> <span class=\"ds-chip ds-chip-ur\">URGENT</span> <span class=\"ds-chip ds-chip-ro\">ROUTINE</span>",
      "css": ".ds-chip{display:inline-block;padding:4px 8px;border-radius:6px;font:700 11px/1 ui-sans-serif,system-ui,sans-serif;letter-spacing:.06em;white-space:nowrap}.ds-chip-em{background:var(--color-critical-700, #b91c1c);color:#fff}.ds-chip-ur{background:var(--color-warning-100, #fef3c7);color:var(--color-warning-800, #854d0e)}.ds-chip-ro{background:var(--color-slate-200, #e8e6dc);color:var(--color-slate-700, #5f5d54)}"
    },
    {
      "name": "Queue Card",
      "kind": "card",
      "refersTo": "card-queue",
      "description": "ReferralCockpitCard: 6px rail, 17px/600 name, context line, chip, action sentence, one action.",
      "html": "<article class=\"ds-card\"><span class=\"ds-card-rail\"></span><div class=\"ds-card-body\"><div class=\"ds-card-top\"><div><p class=\"ds-card-name\">Mona Farouk, 64</p><p class=\"ds-card-line\">ICU · Cardiology</p></div><span class=\"ds-card-chip\">URGENT</span></div><p class=\"ds-card-ask\">Send the ECG the department asked for</p><button class=\"ds-card-btn\">Add ECG</button></div></article>",
      "css": ".ds-card{display:flex;overflow:hidden;border:1px solid var(--color-slate-200, #e8e6dc);border-radius:12px;background:#fff;max-width:420px}.ds-card-rail{width:6px;flex-shrink:0;background:var(--color-warning-800, #854d0e)}.ds-card-body{flex:1;padding:14px;font-family:ui-sans-serif,system-ui,sans-serif}.ds-card-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.ds-card-name{margin:0;font-size:17px;font-weight:600;line-height:1.25;color:var(--color-ink, #141413)}.ds-card-line{margin:3px 0 0;font-size:13.5px;line-height:1.4;color:var(--color-slate-700, #5f5d54)}.ds-card-chip{padding:4px 8px;border-radius:6px;background:var(--color-warning-100, #fef3c7);color:var(--color-warning-800, #854d0e);font-size:11px;font-weight:700;letter-spacing:.06em;line-height:1}.ds-card-ask{margin:10px 0 0;font-size:15px;font-weight:600;line-height:1.4;color:var(--color-warning-800, #854d0e)}.ds-card-btn{margin-top:12px;width:100%;min-height:52px;border:0;border-radius:10px;background:var(--color-ink, #141413);color:var(--color-paper, #faf9f5);font:600 16px/1.2 inherit;cursor:pointer}.ds-card-btn:hover{background:var(--color-slate-800, #3a392f)}.ds-card-btn:focus-visible{outline:2px solid var(--color-info-700, #445f7a);outline-offset:2px}"
    },
    {
      "name": "Escalation Card",
      "kind": "custom",
      "refersTo": "card-escalation",
      "description": "Pinned escalated case: 2px brick border, solid brick header strip naming reason and wait.",
      "html": "<section class=\"ds-esc\"><p class=\"ds-esc-strip\">Escalated · no response 34 min</p><div class=\"ds-esc-body\"><p class=\"ds-esc-name\">Ahmed Saleh, 51</p><p class=\"ds-esc-line\">CCU bed · chest pain · from Fayed Central</p><button class=\"ds-esc-btn\">Review now</button></div></section>",
      "css": ".ds-esc{overflow:hidden;max-width:420px;border:2px solid var(--color-critical-700, #b91c1c);border-radius:12px;background:var(--color-critical-100, #fee2e2);font-family:ui-sans-serif,system-ui,sans-serif}.ds-esc-strip{margin:0;padding:8px 14px;background:var(--color-critical-700, #b91c1c);color:#fff;font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.ds-esc-body{padding:12px 14px 14px}.ds-esc-name{margin:0;font-size:17px;font-weight:600;color:var(--color-ink, #141413)}.ds-esc-line{margin:3px 0 0;font-size:13.5px;color:var(--color-critical-900, #7f1d1d)}.ds-esc-btn{margin-top:12px;width:100%;min-height:52px;border:0;border-radius:10px;background:var(--color-ink, #141413);color:var(--color-paper, #faf9f5);font:600 15px/1.2 inherit;cursor:pointer}.ds-esc-btn:hover{background:var(--color-slate-800, #3a392f)}.ds-esc-btn:focus-visible{outline:2px solid var(--color-info-700, #445f7a);outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "nav",
      "refersTo": "segment-active",
      "description": "Equal-width 52px segments carrying their own case counts.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-b on\" aria-pressed=\"true\"><span>Incoming</span><small>4 cases</small></button><button class=\"ds-seg-b\" aria-pressed=\"false\"><span>Outgoing</span><small>2 cases</small></button></div>",
      "css": ".ds-seg{display:flex;gap:8px;max-width:420px;font-family:ui-sans-serif,system-ui,sans-serif}.ds-seg-b{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:52px;border:1px solid var(--color-slate-200, #e8e6dc);border-radius:10px;background:#fff;color:var(--color-ink, #141413);cursor:pointer;transition:background-color .15s}.ds-seg-b span{font-size:14.5px;font-weight:600}.ds-seg-b small{margin-top:2px;font-size:11.5px;color:var(--color-slate-500, #78766d)}.ds-seg-b:hover{background:var(--color-slate-50, #faf9f5)}.ds-seg-b.on{background:var(--color-ink, #141413);border-color:var(--color-ink, #141413);color:var(--color-paper, #faf9f5)}.ds-seg-b.on small{color:rgba(250,249,245,.7)}.ds-seg-b:focus-visible{outline:2px solid var(--color-info-700, #445f7a);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "54px wizard field with 12.5px/600 label; 16px text.",
      "html": "<label class=\"ds-field\"><span>Patient name</span><input placeholder=\"Full name as on ID\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;max-width:420px;font-family:ui-sans-serif,system-ui,sans-serif}.ds-field span{font-size:12.5px;font-weight:600;color:var(--color-slate-700, #5f5d54)}.ds-field input{min-height:54px;padding:0 14px;border:1px solid var(--color-slate-300, #b0aea5);border-radius:10px;background:#fff;color:var(--color-ink, #141413);font-size:16px;transition:border-color .15s,box-shadow .15s}.ds-field input::placeholder{color:var(--color-slate-500, #78766d)}.ds-field input:focus{outline:none;border-color:var(--color-info-700, #445f7a);box-shadow:0 0 0 2px rgba(68,95,122,.3)}"
    },
    {
      "name": "Phone Screen Header",
      "kind": "nav",
      "refersTo": "header-bar-phone",
      "description": "Full-bleed ink title bar on phones with the 48px menu square.",
