rules_version = '2';

// These rules are the ONLY server-side authorization layer in this app — there is
// no backend, the browser talks straight to Firestore. Anything not denied here is
// reachable by anyone who can complete the public sign-up form on /login.
//
// Query shapes in src/contexts/DataContext.tsx are coupled to the `list` rules
// below: Firestore evaluates a list against the *query*, not the results, so an
// unfiltered collection listener is rejected outright when the rule depends on
// `resource.data`. Change one, change the other, and run `npm run test:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function callerPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function callerDoc() {
      return get(callerPath()).data;
    }
    function callerExists() {
      return signedIn() && exists(callerPath());
    }
    function isPrivileged() {
      return callerExists() && callerDoc().role in ['owner', 'system_admin'];
    }
    // Verification is an explicit act by facility leadership (FacilitySettingsPage).
    // Everything that touches patient data requires it.
    //
    // email_verified is set automatically for Google sign-in and requires the user
    // to click a link for email/password registration. Without it an attacker can
    // sign up with someone else's address and — once admin-verified by mistake —
    // act under that identity. Google Provider accounts are always email_verified.
    function isVerifiedCaller() {
      return callerExists()
          
          && callerDoc().verified == true;
    }
    function callerFacility() {
      return callerDoc().facilityId;
    }
    function atFacility(facilityId) {
      return isVerifiedCaller() && callerFacility() == facilityId;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Roles trusted with facility *configuration* (department lists), as opposed to
    // day-to-day occupancy. Mirrors the admin gate in BedManagementPage /
    // FacilitySettingsPage.
    function isFacilityConfigRole() {
      return callerDoc().role in ['medical_director', 'hospital_manager', 'deputy_manager', 'head_of_department'];
    }
    // The four bed types are fixed by the BedType union in src/types/index.ts, so
    // they can be enumerated here -- rules cannot iterate a map's keys.
    function bedTotalsUnchanged() {
      return request.resource.data.capacity.ICU.total == resource.data.capacity.ICU.total
          && request.resource.data.capacity.CCU.total == resource.data.capacity.CCU.total
          && request.resource.data.capacity.PICU.total == resource.data.capacity.PICU.total
          && request.resource.data.capacity.Ward.total == resource.data.capacity.Ward.total;
    }
    // Occupancy that exceeds its total, or goes negative, is what the routing code
    // reads as "no beds" or "beds available". Bound it at the boundary.
    function bedCountSane(bed) {
      return bed.occupied >= 0 && bed.total >= 0 && bed.occupied <= bed.total;
    }
    function occupancyWithinTotals() {
      return bedCountSane(request.resource.data.capacity.ICU)
          && bedCountSane(request.resource.data.capacity.CCU)
          && bedCountSane(request.resource.data.capacity.PICU)
          && bedCountSane(request.resource.data.capacity.Ward);
    }

    // ---------------------------------------------------------------- users
    // role/verified/facilityId are the basis of every decision in this file, so a
    // user must never be able to set them on themselves. facilityId is the one
    // exception: it is self-selectable during onboarding and frozen the moment an
    // admin verifies the account, which is what makes it trustworthy afterwards.
    function privilegeFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
          && request.resource.data.verified == resource.data.verified
          && (resource.data.verified != true
              || request.resource.data.facilityId == resource.data.facilityId);
    }

    match /users/{userId} {
      // Own document must stay readable before verification — AuthContext
      // subscribes to it to discover that verification has landed.
      allow get: if signedIn() && (request.auth.uid == userId || isVerifiedCaller());
      // The full roster is read by verified staff only. It is needed in full (not
      // facility-scoped) because notification fan-out is done client-side and has
      // to find recipients at the *receiving* facility. Moving fan-out into a
      // Cloud Function would let this be narrowed to one facility.
      allow list: if isVerifiedCaller();

      // Self-signup is always an unverified resident, except for a single exact-match
      // bootstrap hatch that lets the initial owner account promote itself once. It
      // must stay an exact email comparison, not a substring/regex match — a substring
      // check lets any attacker-controlled mailbox containing that text as part of a
      // larger address (e.g. registering "x<owner>x@attacker.com") pass the match and
      // self-grant role: 'owner'. Revoke by removing this clause once the owner
      // document exists and admin tooling can promote further owners server-side.
      allow create: if signedIn() && request.auth.uid == userId
                    && (
                      (request.resource.data.verified == false && request.resource.data.role == 'resident')
                      ||
                      (
                        request.auth.token.email == 'hassan.abdelmenem@gmail.com'
                        && request.auth.token.email_verified == true
                        && request.resource.data.verified == true
                        && request.resource.data.role == 'owner'
                      )
                    );

      allow update: if isPrivileged()
                    || (signedIn() && request.auth.uid == userId && privilegeFieldsUnchanged())
                    || (
                         signedIn() && request.auth.uid == userId
                         && request.auth.token.email == 'hassan.abdelmenem@gmail.com'
                         && request.auth.token.email_verified == true
                         && request.resource.data.role == 'owner'
                         && request.resource.data.verified == true
                       );
      allow delete: if isPrivileged();
    }

    // ----------------------------------------------------------- facilities
    // Readable pre-verification: the onboarding form has to render the hospital
    // picker before the account exists in any facility.
    match /facilities/{facilityId} {
      allow read: if signedIn();
      allow create, delete: if isPrivileged();
      // Two different things live behind this one rule, and they need different
      // trust levels:
      //
      //   capacity    — bed occupancy. Changes on every admission and discharge,
      //                 including from the increment inside updateReferralStatus,
      //                 so any verified account at the facility must be able to
      //                 write it or routine admissions fail.
      //   departments — facility configuration. Rarely changes, and a resident
      //                 silently rewriting the department list is not routine.
      //
      // Previously only owner/system_admin could write either, so both screens
      // failed silently; widening it to atFacility() alone would have handed
      // configuration to every resident.
      // Occupancy and bed *totals* are now separated. Anyone verified at the
      // facility may move `occupied` (every admission and discharge does, via the
      // increment inside updateReferralStatus), but changing `total` is
      // configuration and needs a senior role.
      //
      // That distinction matters more than it used to: capacity is now an input to
      // routing and to automatic escalation, so a single write of
      // `total: 0` across the board removed a hospital from every candidate list
      // network-wide, and `total: 9999` suppressed genuine no-beds escalations
      // while making the facility the top pick for patients it could not take.
      allow update: if isPrivileged()
                    || (atFacility(facilityId)
                        && changedKeys().hasOnly(['capacity'])
                        && bedTotalsUnchanged()
                        && occupancyWithinTotals())
                    || (atFacility(facilityId)
                        && isFacilityConfigRole()
                        && changedKeys().hasOnly(['capacity', 'departments'])
                        && occupancyWithinTotals());
    }

    // ------------------------------------------------------------ referrals
    // The two sides of a referral. `isReferralParty` below is their union and
    // governs reads; these two govern *which* side may make which decision.
    function isReferringParty(data) {
      return callerFacility() == data.referringFacilityId;
    }
    function isReceivingParty(data) {
      return callerFacility() == data.receivingFacilityId
          || (data.receivingFacilityId == 'auto'
              && data.candidateFacilityIds is list
              && callerFacility() in data.candidateFacilityIds);
    }
    function isReferralParty(data) {
      return ('referringFacilityId' in data && callerFacility() == data.referringFacilityId)
          || ('receivingFacilityId' in data && callerFacility() == data.receivingFacilityId)
          || ('receivingFacilityId' in data && data.receivingFacilityId == 'auto'
              && 'candidateFacilityIds' in data
              && callerFacility() in data.candidateFacilityIds);
    }
    // Mirrors SENIOR_CANCEL_ROLES / CANCEL_LOCKED_STATUSES in
    // src/contexts/DataContext.tsx -- keep all three in sync.
    function isSeniorCancelRole() {
      return callerDoc().role in ['medical_director', 'hospital_manager', 'deputy_manager', 'head_of_department'];
    }
    function isCancelAttempt(newData) {
      return newData.status == 'cancelled';
    }
    function isCancelLocked(existingData) {
      return existingData.status in ['in_transit', 'arrived', 'admitted', 'discharged'];
    }
    function canCancelReferral(existingData) {
      // isVerifiedCaller() is required here too. Without it an unverified account
      // could self-declare a senior role + facility and cancel live transfers.
      return isVerifiedCaller() && !isCancelLocked(existingData) &&
             (isPrivileged()
               || existingData.referringUserId == request.auth.uid
               || (callerFacility() == existingData.referringFacilityId && isSeniorCancelRole()));
    }
    // Authorization is computed from the pre-write document, so without these the
    // payload is unconstrained: any party could rewrite patientData, forge the
    // audit trail, or reassign referringFacilityId and lock the originating
    // hospital out of its own patient's record.
    function referralIdentityPinned() {
      return request.resource.data.referringFacilityId == resource.data.referringFacilityId
          && request.resource.data.referringUserId == resource.data.referringUserId
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.createdAt == resource.data.createdAt
          // createdAtMs is the SLA clock (see slaWindowElapsed). If it were
          // editable, a party could push it forward and switch the 30-minute
          // escalation off for that referral permanently.
          && (!('createdAtMs' in resource.data)
              || request.resource.data.createdAtMs == resource.data.createdAtMs)
          // Set once at creation by the referring clinician. Without pinning
          // this, any party could flip it to false in an ordinary intermediate
          // update -- one that never touches `status` at all -- and silently
          // defeat accompanyingDoctorSatisfied() on the later in_transit write.
          // Missing on referrals created before this field existed; those are
          // let through rather than becoming permanently un-editable.
          && (!('requiresAccompanyingDoctor' in resource.data)
              || request.resource.data.requiresAccompanyingDoctor == resource.data.requiresAccompanyingDoctor);
    }

    // The clinical record itself. Pinned for everyone except the clinician who
    // raised the referral, because authorization here is computed from the
    // pre-write document and nothing else stopped a verified account at any
    // candidate facility from rewriting a diagnosis or deleting an allergy on the
    // record the receiving hospital acts on -- silently, with no audit entry.
    function referralClinicalDataPinned() {
      return request.resource.data.patientData == resource.data.patientData
          && request.resource.data.requiredBedType == resource.data.requiredBedType;
    }
    function mayEditClinicalData() {
      return isPrivileged() || resource.data.referringUserId == request.auth.uid;
    }

    // Candidate facilities may be removed (recordPatientDecline prunes the list)
    // but never added. Widening it is a read grant: isReferralParty admits every
    // verified user at every listed facility, so appending ids hands the full
    // patient record to hospitals that were never involved.
    function candidateListNotWidened() {
      return !('candidateFacilityIds' in request.resource.data)
          || !(request.resource.data.candidateFacilityIds is list)
          || !('candidateFacilityIds' in resource.data)
          || !(resource.data.candidateFacilityIds is list)
          || request.resource.data.candidateFacilityIds.hasOnly(resource.data.candidateFacilityIds);
    }

    // Has the 30-minute SLA actually elapsed, by server clock?
    //
    // This is what makes an automatic escalation checkable rather than merely
    // claimed. On the Spark plan the escalation is written by the browser, so the
    // rules cannot tell the real sweep from a hostile client -- both are the same
    // signed-in user. What they *can* verify is that the condition being asserted
    // is true: an 'sla_breach' escalation is only accepted once the referral has
    // genuinely been waiting 30 minutes, at which point the escalation is correct
    // no matter who wrote it.
    //
    // Referrals created before createdAtMs existed cannot be checked; they are
    // allowed through rather than becoming permanently un-escalatable.
    function slaWindowElapsed() {
      return !('createdAtMs' in resource.data)
          || request.time.toMillis() >= resource.data.createdAtMs + 1800000;
    }

    // Escalation is a claim about why a patient is stuck, and the banner tells
    // staff what to do about it -- including, for the capacity reasons, to stop
    // chasing the receiving facilities. So the claim has to be internally
    // consistent and attributable.
    //
    // Residual gap, unavoidable client-side: the rules cannot confirm that the
    // network really is out of beds, because that needs a read of every candidate
    // facility and rules allow at most ten get() calls. 'no_beds_available' is
    // therefore assertable by any party. Moving escalation into the scheduled
    // Cloud Function is what closes it.
    function escalationClaimValid() {
      // Only checked when the write actually touches escalation. Validating it on
      // every update would mean that after user A escalates manually, the
      // "signed by the caller" clause below fails for everyone except A -- so
      // nobody else could advance the referral at all.
      return !changedKeys().hasAny(['isEscalated', 'escalatedAt', 'escalatedBy', 'escalationReason', 'escalationLevel'])
          || !request.resource.data.isEscalated
          || (request.resource.data.escalationReason in ['sla_breach', 'no_matching_facility', 'no_beds_available', 'manual', 'requirements_needed']
              && request.resource.data.escalationLevel in ['system', 'facility']
              // A human escalation must be signed by the human.
              && (request.resource.data.escalationReason != 'manual'
                  || request.resource.data.escalatedBy == request.auth.uid)
              // An automatic one must not be signed by a human, so 'system' in the
              // audit trail keeps meaning "nobody acted".
              && (request.resource.data.escalationReason == 'manual'
                  || request.resource.data.escalatedBy == 'system')
              && (request.resource.data.escalationReason != 'sla_breach' || slaWindowElapsed())
              // The capacity reasons are the top tier by definition.
              && (!(request.resource.data.escalationReason in ['no_matching_facility', 'no_beds_available'])
                  || request.resource.data.escalationLevel == 'system'));
    }
    // Rules cannot iterate a list, so a true element-wise prefix comparison is not
    // expressible here. What is enforced: the trail grows by exactly one entry when
    // the status moves and by none when it doesn't (so a caller cannot smuggle in a
    // rewritten history under cover of padding), and the opening entry is immutable.
    //
    // Residual gap: the middle of the trail can still be rewritten by a party. The
    // durable fix is to move history into an immutable subcollection
    // (referrals/{id}/statusHistory/{entryId}, create-only, no update or delete) so
    // append-only becomes a property of the data model rather than a predicate.
    // "At most one new entry per write", not "exactly one when the status moves".
    // Escalation, de-escalation and destination overrides all append an audit entry
    // while leaving `status` untouched, so keying the allowed growth off a status
    // change would reject every one of them -- including the automatic SLA
    // escalation, whose whole purpose is to leave a record.
    function auditTrailAppendOnly() {
      return request.resource.data.statusHistory is list
          && (request.resource.data.statusHistory.size() == resource.data.statusHistory.size()
              || request.resource.data.statusHistory.size() == resource.data.statusHistory.size() + 1)
          && (resource.data.statusHistory.size() == 0
              || request.resource.data.statusHistory[0] == resource.data.statusHistory[0]);
    }

    // The status graph, enforced server-side. Without it the only thing standing
    // between a referral and an arbitrary status was updateReferralStatus() in the
    // client, which a caller talking to the SDK directly simply skips -- letting a
    // patient be marked in_transit without ever having consented.
    //
    // It also closes the cancel-lock bypass: CANCEL_LOCKED_STATUSES refuses
    // cancellation from in_transit onward, but nothing stopped a party stepping the
    // status back to accepted first and cancelling from there. No transition out of
    // a locked status to an unlocked one exists below, so that path is gone.
    //
    // Mirrors updateReferralStatus / recordPatientConsent / recordPatientDecline in
    // src/contexts/DataContext.tsx -- keep them in sync.
    function validStatusTransition() {
      return request.resource.data.status == resource.data.status
          || (resource.data.status == 'pending'
              && request.resource.data.status in ['dept_approved', 'manager_approved', 'accepted', 'rejected', 'postponed', 'cancelled'])
          || (resource.data.status == 'dept_approved'
              && request.resource.data.status in ['manager_approved', 'accepted', 'rejected', 'postponed', 'cancelled'])
          || (resource.data.status == 'manager_approved'
              && request.resource.data.status in ['accepted', 'rejected', 'postponed', 'cancelled'])
          // accepted -> pending is the patient-decline re-route (recordPatientDecline).
          || (resource.data.status == 'accepted'
              && request.resource.data.status in ['patient_consented', 'pending', 'rejected', 'postponed', 'cancelled'])
          || (resource.data.status == 'patient_consented'
              && request.resource.data.status in ['in_transit', 'accepted', 'pending', 'cancelled'])
          || (resource.data.status == 'postponed'
              && request.resource.data.status in ['pending', 'dept_approved', 'manager_approved', 'accepted', 'rejected', 'cancelled'])
          || (resource.data.status == 'rejected'
              && request.resource.data.status in ['pending', 'cancelled'])
          // From here the patient is in motion; these are one-way.
          || (resource.data.status == 'in_transit' && request.resource.data.status == 'arrived')
          || (resource.data.status == 'arrived'
              && request.resource.data.status in ['admitted', 'discharged'])
          || (resource.data.status == 'admitted' && request.resource.data.status == 'discharged');
    }

    // The graph above says which moves exist. This says who may make them.
    //
    // Without it the graph was enforced but the actor was not, so any party could
    // drive any legal edge. Two consequences mattered: a verified account at any
    // candidate facility could record a patient's consent to transfer -- a
    // clinical and legal assertion about a person it has never met -- and could
    // then push the referral to in_transit, which cancel-locks it for everyone
    // including owners, with no transition back.
    //
    // Sides are taken from the UI gating in ReferralDetailPage: approvals and
    // admission belong to the destination, consent belongs to the facility
    // physically holding the patient. The permissive bucket is deliberate --
    // parking, re-opening, arrival and dispatch are all done from either end in
    // practice (a receiving hospital may send its own ambulance), and none of them
    // grants anything that patient_consented has not already gated.
    function transitionActorAllowed() {
      return isPrivileged()
          || request.resource.data.status == resource.data.status
          // Cancellation has its own, stricter rule (canCancelReferral).
          || request.resource.data.status == 'cancelled'
          || (request.resource.data.status == 'patient_consented'
              && isReferringParty(resource.data))
          || (request.resource.data.status in ['dept_approved', 'manager_approved', 'accepted', 'rejected', 'admitted', 'discharged']
              && isReceivingParty(resource.data))
          || (request.resource.data.status in ['pending', 'postponed', 'arrived', 'in_transit']
              && (isReferringParty(resource.data) || isReceivingParty(resource.data)));
    }

    // A transfer flagged at creation as needing a doctor escort cannot be
    // dispatched (moved to in_transit) until the ER Room Official has recorded
    // who that doctor is. Mirrors the client-side guard in updateReferralStatus
    // -- keep both in sync. Only checked on the transition itself, so it never
    // blocks unrelated field edits on a referral that happens to need an escort.
    function accompanyingDoctorSatisfied() {
      return request.resource.data.status != 'in_transit'
          || resource.data.status == 'in_transit'
          || resource.data.get('requiresAccompanyingDoctor', false) != true
          || (request.resource.data.accompanyingDoctor is map
              && request.resource.data.accompanyingDoctor.name is string
              && request.resource.data.accompanyingDoctor.name.size() > 0
              && request.resource.data.accompanyingDoctor.phoneNumber is string
              && request.resource.data.accompanyingDoctor.phoneNumber.size() > 0);
    }

    // The escort assignment is a clinical/legal attestation about who is
    // physically riding with the patient, so who may write it matters as much
    // as its shape (which accompanyingDoctorSatisfied() already checks). It's
    // recorded by ER staff at whichever facility is actually dispatching the
    // ambulance -- either side, mirroring the existing 'in_transit' permissive
    // bucket in transitionActorAllowed() and the client's isErRoom check in
    // ReferralDetailPage.tsx -- but only by the er_official/er_room roles, and
    // only attributed to the caller's own uid. Without this, any verified
    // referral party of any role could fabricate or reassign the escort.
    function accompanyingDoctorWriteAuthorized() {
      return !changedKeys().hasAny(['accompanyingDoctor'])
          || isPrivileged()
          || (isReferralParty(resource.data)
              && callerDoc().role in ['er_official', 'er_room']
              && (request.resource.data.accompanyingDoctor == null
                  || (request.resource.data.accompanyingDoctor is map
                      && request.resource.data.accompanyingDoctor.addedBy == request.auth.uid)));
    }

    match /referrals/{referralId} {
      allow read: if isPrivileged() || (isVerifiedCaller() && isReferralParty(resource.data));

      // Create was previously ownership-only, which let a referral be born in any
      // state. Two things that bought an attacker: `status: 'in_transit'` skipped
      // the entire transition graph (including the consent requirement) and
      // arrived already cancel-locked; and a future `createdAt` -- immutable
      // afterwards -- switched the SLA off for that referral forever.
      //
      // createdAtMs is bounded on the future side only. Backdating merely makes
      // the referral escalate sooner, which is the safe direction to fail in.
      allow create: if (isPrivileged()
                        || (isVerifiedCaller()
                            && callerFacility() == request.resource.data.referringFacilityId
                            && request.resource.data.referringUserId == request.auth.uid))
                    && request.resource.data.status == 'pending'
                    && request.resource.data.isEscalated == false
                    && request.resource.data.statusHistory is list
                    && request.resource.data.statusHistory.size() == 1
                    && request.resource.data.createdAtMs is number
                    && request.resource.data.createdAtMs <= request.time.toMillis() + 300000;

      allow update: if referralIdentityPinned()
                    && auditTrailAppendOnly()
                    && validStatusTransition()
                    && transitionActorAllowed()
                    && candidateListNotWidened()
                    && escalationClaimValid()
                    && accompanyingDoctorSatisfied()
                    && accompanyingDoctorWriteAuthorized()
                    && (referralClinicalDataPinned() || mayEditClinicalData())
                    && (
                      isCancelAttempt(request.resource.data)
                        ? canCancelReferral(resource.data)
                        : (isPrivileged() || (isVerifiedCaller() && isReferralParty(resource.data)))
                    );

      allow delete: if isPrivileged();
    }

    // -------------------------------------------------------- notifications
    // Fan-out is client-side, so any verified caller may create a notification
    // addressed to another user — but reads stay strictly per-recipient, and the
    // only mutable field is the read flag.
    match /notifications/{notificationId} {
      allow read: if isPrivileged() || (signedIn() && resource.data.userId == request.auth.uid);
      // Still open to any verified caller, because fan-out runs in the browser. The
      // shape constraints below are what keep that from being a free-form message
      // channel into every clinician's notification tray: a fabricated alert cannot
      // arrive pre-read, cannot carry an unbounded body, and -- via createdAtMs --
      // cannot be dated into the future to pin itself to the top of the tray
      // forever. An earlier version of this comment claimed backdating was blocked
      // when nothing checked the timestamp at all.
      //
      // Moving fan-out into a Cloud Function would let this become a deny rule and
      // would also let the /users list rule narrow to a single facility.
      allow create: if isVerifiedCaller()
                    && request.resource.data.userId is string
                    && request.resource.data.title is string
                    && request.resource.data.message is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.type in ['urgent', 'info', 'success', 'warning', 'purple']
                    && request.resource.data.read == false
                    && request.resource.data.createdAtMs is number
                    && request.resource.data.createdAtMs <= request.time.toMillis() + 300000;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && changedKeys().hasOnly(['read']);
      // The recipient can clear their own tray. Previously only an admin could
      // delete, so an unwanted or forged alert was permanent for the person
      // receiving it.
      allow delete: if isPrivileged()
                    || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ----------------------------------------------------- directAdmissions
    // Identified patient records (name + hospital id + department).
    match /directAdmissions/{admissionId} {
      allow read: if isPrivileged() || (isVerifiedCaller() && resource.data.facilityId == callerFacility());
      allow create: if isPrivileged() || atFacility(request.resource.data.facilityId);
      // Authorization reads the pre-write document, so the payload needs pinning for
      // the same reason referralIdentityPinned() exists. Without it a verified caller
      // could rewrite facilityId and move an identified patient record out of their
      // own facility's scope -- or into a facility that does not exist, where nobody
      // can reach it again.
      allow update: if isPrivileged()
                    || (isVerifiedCaller()
                        && resource.data.facilityId == callerFacility()
                        && request.resource.data.facilityId == resource.data.facilityId
                        && request.resource.data.patientName == resource.data.patientName
                        && request.resource.data.hospitalId == resource.data.hospitalId
                        && request.resource.data.admittedAt == resource.data.admittedAt
                        && request.resource.data.admittedBy == resource.data.admittedBy);
      allow delete: if isPrivileged();
    }

    // ---------------------------------------------------- shiftAssignments
    // Deliberately readable by any verified user rather than facility-scoped:
    // createNotification resolves on-call delegation at the *receiving* facility.
    // Safe to widen because the document holds no patient data — only a facility,
    // a department and a user id. Writes stay facility-scoped.
    match /shiftAssignments/{assignmentId} {
      allow read: if isVerifiedCaller();
      allow create: if isPrivileged() || atFacility(request.resource.data.facilityId);
      allow update: if isPrivileged() || atFacility(resource.data.facilityId);
      allow delete: if isPrivileged();
    }

    // ------------------------------------------------------------ shiftLogs
    // Handover summaries quote patient names, and they are an audit record:
    // facility-scoped reads, author-pinned creates, and no edits or deletes.
    match /shiftLogs/{logId} {
      allow read: if isPrivileged() || (isVerifiedCaller() && resource.data.facilityId == callerFacility());
      allow create: if isVerifiedCaller()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.facilityId == callerFacility();
      allow update, delete: if false;
    }
  }
}
