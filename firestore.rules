rules_version = '2';

// These rules are the ONLY server-side authorization layer in this app — there is
// no backend, the browser talks straight to Firestore. Anything not denied here is
// reachable by anyone who can complete the public sign-up form on /login.
//
// Query shapes in src/contexts/DataContext.tsx are coupled to the `list` rules
// below: Firestore evaluates a list against the *query*, not the results, so an
// unfiltered collection listener is rejected outright when the rule depends on
// `resource.data`. Change one, change the other, and run `npm run test:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function callerPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function callerDoc() {
      return get(callerPath()).data;
    }
    function callerExists() {
      return signedIn() && exists(callerPath());
    }
    function isPrivileged() {
      return callerExists() && callerDoc().role in ['owner', 'system_admin'];
    }
    // Verification is an explicit act by facility leadership (FacilitySettingsPage).
    // Everything that touches patient data requires it.
    function isVerifiedCaller() {
      return callerExists() && callerDoc().verified == true;
    }
    function callerFacility() {
      return callerDoc().facilityId;
    }
    function atFacility(facilityId) {
      return isVerifiedCaller() && callerFacility() == facilityId;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Roles trusted with facility *configuration* (department lists), as opposed to
    // day-to-day occupancy. Mirrors the admin gate in BedManagementPage /
    // FacilitySettingsPage.
    function isFacilityConfigRole() {
      return callerDoc().role in ['medical_director', 'hospital_manager', 'deputy_manager', 'head_of_department'];
    }

    // ---------------------------------------------------------------- users
    // role/verified/facilityId are the basis of every decision in this file, so a
    // user must never be able to set them on themselves. facilityId is the one
    // exception: it is self-selectable during onboarding and frozen the moment an
    // admin verifies the account, which is what makes it trustworthy afterwards.
    function privilegeFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
          && request.resource.data.verified == resource.data.verified
          && (resource.data.verified != true
              || request.resource.data.facilityId == resource.data.facilityId);
    }

    match /users/{userId} {
      // Own document must stay readable before verification — AuthContext
      // subscribes to it to discover that verification has landed.
      allow get: if signedIn() && (request.auth.uid == userId || isVerifiedCaller());
      // Notification fan-out happens in a Cloud Function, so the client only
      // needs to list users at its own facility.
      allow list: if isPrivileged() || (isVerifiedCaller() && resource.data.facilityId == callerFacility());

      // Self-signup is always an unverified resident. The former bootstrap escape
      // hatch (a hardcoded owner email) is gone: it tied production authorization to
      // one consumer mail account, could not be revoked without a rules deploy, and
      // is unnecessary once the owner document exists. Promote the first owner from
      // the Firebase console, or with a custom claim set by admin tooling.
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.verified == false
                    && request.resource.data.role == 'resident';

      allow update: if isPrivileged()
                    || (signedIn() && request.auth.uid == userId && privilegeFieldsUnchanged());
      allow delete: if isPrivileged();
    }

    // ----------------------------------------------------------- facilities
    // Readable pre-verification: the onboarding form has to render the hospital
    // picker before the account exists in any facility.
    match /facilities/{facilityId} {
      allow read: if signedIn();
      allow create, delete: if isPrivileged();
      // Two different things live behind this one rule, and they need different
      // trust levels:
      //
      //   capacity    — bed occupancy. Changes on every admission and discharge,
      //                 including from the increment inside updateReferralStatus,
      //                 so any verified account at the facility must be able to
      //                 write it or routine admissions fail.
      //   departments — facility configuration. Rarely changes, and a resident
      //                 silently rewriting the department list is not routine.
      //
      // Previously only owner/system_admin could write either, so both screens
      // failed silently; widening it to atFacility() alone would have handed
      // configuration to every resident.
      allow update: if isPrivileged()
                    || (atFacility(facilityId) && changedKeys().hasOnly(['capacity']))
                    || (atFacility(facilityId)
                        && isFacilityConfigRole()
                        && changedKeys().hasOnly(['capacity', 'departments']));
    }

    // ------------------------------------------------------------ referrals
    function isReferralParty(data) {
      return ('referringFacilityId' in data && callerFacility() == data.referringFacilityId)
          || ('receivingFacilityId' in data && callerFacility() == data.receivingFacilityId)
          || ('receivingFacilityId' in data && data.receivingFacilityId == 'auto'
              && 'candidateFacilityIds' in data
              && data.candidateFacilityIds.hasAny([callerFacility()]));
    }
    // Mirrors SENIOR_CANCEL_ROLES / CANCEL_LOCKED_STATUSES in
    // src/contexts/DataContext.tsx -- keep all three in sync.
    function isSeniorCancelRole() {
      return callerDoc().role in ['medical_director', 'hospital_manager', 'deputy_manager', 'head_of_department'];
    }
    function isCancelAttempt(newData) {
      return newData.status == 'cancelled';
    }
    function isCancelLocked(existingData) {
      return existingData.status in ['in_transit', 'arrived', 'admitted', 'discharged'];
    }
    function canCancelReferral(existingData) {
      // isVerifiedCaller() is required here too. Without it an unverified account
      // could self-declare a senior role + facility and cancel live transfers.
      return isVerifiedCaller() && !isCancelLocked(existingData) &&
             (isPrivileged()
               || existingData.referringUserId == request.auth.uid
               || (callerFacility() == existingData.referringFacilityId && isSeniorCancelRole()));
    }
    // Authorization is computed from the pre-write document, so without these the
    // payload is unconstrained: any party could rewrite patientData, forge the
    // audit trail, or reassign referringFacilityId and lock the originating
    // hospital out of its own patient's record.
    function referralIdentityPinned() {
      return request.resource.data.referringFacilityId == resource.data.referringFacilityId
          && request.resource.data.referringUserId == resource.data.referringUserId
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Rules cannot iterate a list, so a true element-wise prefix comparison is not
    // expressible here. What is enforced: the trail grows by exactly one entry when
    // the status moves and by none when it doesn't (so a caller cannot smuggle in a
    // rewritten history under cover of padding), and the opening entry is immutable.
    //
    // Residual gap: the middle of the trail can still be rewritten by a party. The
    // durable fix is to move history into an immutable subcollection
    // (referrals/{id}/statusHistory/{entryId}, create-only, no update or delete) so
    // append-only becomes a property of the data model rather than a predicate.
    // residual gap fixed: statusHistory moved to an immutable subcollection.

    // The status graph, enforced server-side. Without it the only thing standing
    // between a referral and an arbitrary status was updateReferralStatus() in the
    // client, which a caller talking to the SDK directly simply skips -- letting a
    // patient be marked in_transit without ever having consented.
    //
    // It also closes the cancel-lock bypass: CANCEL_LOCKED_STATUSES refuses
    // cancellation from in_transit onward, but nothing stopped a party stepping the
    // status back to accepted first and cancelling from there. No transition out of
    // a locked status to an unlocked one exists below, so that path is gone.
    //
    // Mirrors updateReferralStatus / recordPatientConsent / recordPatientDecline in
    // src/contexts/DataContext.tsx -- keep them in sync.
    function validStatusTransition() {
      return request.resource.data.status == resource.data.status
          || (resource.data.status == 'pending'
              && request.resource.data.status in ['dept_approved', 'manager_approved', 'accepted', 'rejected', 'postponed', 'cancelled'])
          || (resource.data.status == 'dept_approved'
              && request.resource.data.status in ['manager_approved', 'accepted', 'rejected', 'postponed', 'cancelled'])
          || (resource.data.status == 'manager_approved'
              && request.resource.data.status in ['accepted', 'rejected', 'postponed', 'cancelled'])
          // accepted -> pending is the patient-decline re-route (recordPatientDecline).
          || (resource.data.status == 'accepted'
              && request.resource.data.status in ['patient_consented', 'pending', 'rejected', 'postponed', 'cancelled'])
          || (resource.data.status == 'patient_consented'
              && request.resource.data.status in ['in_transit', 'accepted', 'pending', 'cancelled'])
          || (resource.data.status == 'postponed'
              && request.resource.data.status in ['pending', 'dept_approved', 'manager_approved', 'accepted', 'rejected', 'cancelled'])
          || (resource.data.status == 'rejected'
              && request.resource.data.status in ['pending', 'cancelled'])
          // From here the patient is in motion; these are one-way.
          || (resource.data.status == 'in_transit' && request.resource.data.status == 'arrived')
          || (resource.data.status == 'arrived'
              && request.resource.data.status in ['admitted', 'discharged'])
          || (resource.data.status == 'admitted' && request.resource.data.status == 'discharged');
    }

    match /referrals/{referralId} {
      allow read: if isPrivileged() || (isVerifiedCaller() && isReferralParty(resource.data));

      allow create: if isPrivileged()
                    || (isVerifiedCaller()
                        && callerFacility() == request.resource.data.referringFacilityId
                        && request.resource.data.referringUserId == request.auth.uid);

      allow update: if referralIdentityPinned()
                    && validStatusTransition()
                    && (
                      isCancelAttempt(request.resource.data)
                        ? canCancelReferral(resource.data)
                        : (isPrivileged() || (isVerifiedCaller() && isReferralParty(resource.data)))
                    );

      allow delete: if isPrivileged();

      match /statusHistory/{entryId} {
        allow read: if isPrivileged() || (isVerifiedCaller() && isReferralParty(get(/databases/$(database)/documents/referrals/$(referralId)).data));
        allow create: if isPrivileged() || (isVerifiedCaller() && isReferralParty(get(/databases/$(database)/documents/referrals/$(referralId)).data));
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------- notifications
    // Fan-out is client-side, so any verified caller may create a notification
    // addressed to another user — but reads stay strictly per-recipient, and the
    // only mutable field is the read flag.
    match /notifications/{notificationId} {
      allow read: if isPrivileged() || (signedIn() && resource.data.userId == request.auth.uid);
      // Fan-out runs in a Cloud Function, which bypasses rules.
      allow create: if false;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && changedKeys().hasOnly(['read']);
      allow delete: if isPrivileged();
    }

    // ----------------------------------------------------- directAdmissions
    // Identified patient records (name + hospital id + department).
    match /directAdmissions/{admissionId} {
      allow read: if isPrivileged() || (isVerifiedCaller() && resource.data.facilityId == callerFacility());
      allow create: if isPrivileged() || atFacility(request.resource.data.facilityId);
      // Authorization reads the pre-write document, so the payload needs pinning for
      // the same reason referralIdentityPinned() exists. Without it a verified caller
      // could rewrite facilityId and move an identified patient record out of their
      // own facility's scope -- or into a facility that does not exist, where nobody
      // can reach it again.
      allow update: if isPrivileged()
                    || (isVerifiedCaller()
                        && resource.data.facilityId == callerFacility()
                        && request.resource.data.facilityId == resource.data.facilityId
                        && request.resource.data.patientName == resource.data.patientName
                        && request.resource.data.hospitalId == resource.data.hospitalId
                        && request.resource.data.admittedAt == resource.data.admittedAt
                        && request.resource.data.admittedBy == resource.data.admittedBy);
      allow delete: if isPrivileged();
    }

    // ---------------------------------------------------- shiftAssignments
    // Cloud Functions handle cross-facility notification fan-out, so clients
    // only need to read their own facility's shift assignments.
    match /shiftAssignments/{assignmentId} {
      allow read: if isPrivileged() || (isVerifiedCaller() && resource.data.facilityId == callerFacility());
      allow create: if isPrivileged() || atFacility(request.resource.data.facilityId);
      allow update: if isPrivileged() || atFacility(resource.data.facilityId);
      allow delete: if isPrivileged();
    }

    // ------------------------------------------------------------ shiftLogs
    // Handover summaries quote patient names, and they are an audit record:
    // facility-scoped reads, author-pinned creates, and no edits or deletes.
    match /shiftLogs/{logId} {
      allow read: if isPrivileged() || (isVerifiedCaller() && resource.data.facilityId == callerFacility());
      allow create: if isVerifiedCaller()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.facilityId == callerFacility();
      allow update, delete: if false;
    }
  }
}
