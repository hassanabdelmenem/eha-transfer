node_modules/
build/
dist/
# Cloud Functions build output -- compiled from functions/src by the predeploy
# hook in firebase.json, so a deploy can never ship a stale committed copy.
functions/lib/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Firebase CLI deploy cache — machine-local hashes of the last upload.
# Committing it makes deploys from a different machine (or CI) look dirty.
.firebase/
firebase-debug.log
firestore-debug.log

# Firebase Auth / Firestore exports. These contain real user PII (emails,
# display names, uids) and must never reach the repo. accounts.json was
# committed under a name this pattern didn't cover (see the security
# assessment, F1) -- broadened to catch that shape too.
auth.json
accounts.json
accounts*.json
*-accounts.json
*-export/
firestore-export/

# testing
/playwright-report
/test-results

# temp sandboxes created by mutation testing tooling
.stryker-tmp/

# AI tool configuration and state
# Claude Code: share the team config (settings, hooks, skills, agents); keep personal
# state (settings.local.json, worktrees, launch.json) local.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/agents/
.copilot/
_to_delete/

# Graphify knowledge graph
# graphify-out/ IS committed on purpose - the graph travels with the repo.
# These two are local-only:
graphify-out/cost.json
graphify-out/cache/

# One-off agent scratch work (see CLAUDE.md, Housekeeping). Keep it out of the
# repo: it pollutes search and the graphify graph.
scratch/
/check_img.*
/formatted.js
/test_*.cjs
/run_*.cjs
/*.png
