# Firebase CLI deploy cache — machine-local hashes of the last upload.
# Committing it makes deploys from a different machine (or CI) look dirty.
.firebase/
firebase-debug.log
firestore-debug.log

# Firebase Auth / Firestore exports. These contain real user PII (emails,
# display names, uids) and must never reach the repo.
auth.json
*-export/
firestore-export/

# testing
/playwright-report
/test-results
.auth_state.json

# temp sandboxes created by mutation testing tooling
.stryker-tmp/
