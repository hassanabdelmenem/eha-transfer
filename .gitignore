node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Firebase CLI deploy cache — machine-local hashes of the last upload.
# Committing it makes deploys from a different machine (or CI) look dirty.
.firebase/
firebase-debug.log
firestore-debug.log

# Firebase Auth / Firestore exports. These contain real user PII (emails,
# display names, uids) and must never reach the repo. accounts.json was
# committed under a name this pattern didn't cover (see the security
# assessment, F1) -- broadened to catch that shape too.
auth.json
accounts.json
accounts*.json
*-accounts.json
*-export/
firestore-export/

# testing
/playwright-report
/test-results

# temp sandboxes created by mutation testing tooling
.stryker-tmp/

# AI tool configuration and state
.claude/
.copilot/
_to_delete/

# Graphify knowledge graph
# graphify-out/ IS committed on purpose - the graph travels with the repo.
# These two are local-only:
graphify-out/cost.json
graphify-out/cache/
