{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/hassanabdelmenem/antigravity/eha-transfer/.codex/hooks/guard-edits.sh'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__firebase__firestore_query_collection",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/hassanabdelmenem/antigravity/eha-transfer/.codex/hooks/firestore-emulator-only.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/hassanabdelmenem/antigravity/eha-transfer/.codex/hooks/rules-reminder.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/hassanabdelmenem/antigravity/eha-transfer/.codex/hooks/stop-typecheck.sh'",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
