{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts", "!src/__snapshots__/**"],
  "testRunner": "vitest",
  "packageManager": "npm",
  "reporters": ["progress", "clear-text", "html"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "tsconfigFile": "tsconfig.stryker-disabled.json",
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    ".firebase",
    ".git",
    ".github",
    ".agents",
    ".claude"
  ]
}
