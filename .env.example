# Example environment variables for local development.
# Copy to .env and fill with your project's values. Do NOT commit real secrets.

# Firebase configuration (required in non-dev builds)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_NUMBER=

# When true, the app will talk to local Firebase emulators (auth + firestore)
VITE_USE_FIREBASE_EMULATORS=false

# Comma-separated list of emails that should be auto-promoted to owner in dev/emulator mode
# Example: VITE_DEV_OWNER_EMAILS=alice@example.com,bob@example.com
VITE_DEV_OWNER_EMAILS=
